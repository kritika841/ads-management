CRON_TZ=Asia/Kolkata
# The wrapper owns the shared lock and timeout so cron, PM2, manual runs, and the
# GitHub fallback can never process the same clip concurrently.
*/10 * * * * /bin/bash /home/deployer/apps/satmi-ads/scripts/run-ingest-cron.sh >> /home/deployer/logs/ingest-clip-segments.log 2>&1
# Fixed daily audit/retry pass at 00:15 IST.
15 0 * * * /bin/bash /home/deployer/apps/satmi-ads/scripts/run-ingest-cron.sh >> /home/deployer/logs/ingest-clip-segments.log 2>&1
